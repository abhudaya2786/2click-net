# Local dev:
# REACT_APP_BACKEND_URL=http://localhost:8001
#
# Production (Vercel): must be a LIVE backend URL that resolves in DNS.
# Example: https://api.buildecogroup.com  (only after DNS A/CNAME record is created)
# Wrong: https://api.example.com or a domain with no DNS record
REACT_APP_BACKEND_URL=http://localhost:8001
