# Root runtime JSON only (auth/company). Do NOT use bare `data/` —
# that also drops src/data/ and breaks Vite (sampleMeetings).
/data/

# Nested lockfile under api/ confuses Vercel install / function detection
api/package-lock.json
api/node_modules/

.env
.env.*
!.env.example
node_modules/
.vercel/
android/
*.apk
coverage/
