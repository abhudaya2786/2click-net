{
  "name": "2click-voice-mom",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "npm install --no-audit --no-fund",
  "ports": [
    { "name": "app", "port": 3000 }
  ],
  "terminals": [
    {
      "name": "mom-dev",
      "command": "npm run dev",
      "description": "Voice MoM Vite+Express dev server on port 3000"
    }
  ]
}
