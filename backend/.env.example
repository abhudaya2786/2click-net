# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=buildecogroup_db

# Auth (required)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@buildecogroup.com
ADMIN_PASSWORD=ChangeMe123!

# Optional — payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_API_KEY=

# Optional — AI assistant
EMERGENT_LLM_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-pro-preview
# Optional — OpenAI path for Sales MoM (preferred when set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional — admin hardening
ADMIN_ACCESS_PIN=
ADMIN_IP_ALLOWLIST=
ENABLE_TEST_OTP=0

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000,https://buildecogroup.com,https://www.buildecogroup.com
