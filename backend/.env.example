# MongoDB
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=buildecogroup_db

# Auth (required) — owner super admin is created/updated from these on every API start
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@buildecogroup.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_ACCESS_PIN=

# Optional — harden admin
ADMIN_IP_ALLOWLIST=
# Password login is default. Set to 1 only if you want email OTP after password.
ADMIN_REQUIRE_OTP=0
# Legacy alias: 1 also skips OTP (same as password-only)
ENABLE_TEST_OTP=1
# Keep 0 — Emergent Google OAuth is off for owner-controlled deploys
ENABLE_EMERGENT_GOOGLE=0

# Owner email (preferred — your Resend account, not Emergent)
RESEND_API_KEY=
EMAIL_FROM=noreply@buildecogroup.com
EMAIL_FROM_NAME=BuildEco Group
# Legacy only (optional): EMERGENT_EMAIL_KEY=

# Optional — payments (your keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_API_KEY=

# Optional — AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
EMERGENT_LLM_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-pro-preview

# CORS — include your Vercel / custom domains
CORS_ORIGINS=http://localhost:3000,https://buildecogroup.com,https://www.buildecogroup.com
