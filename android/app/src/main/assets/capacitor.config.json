{
	"appId": "in.twoclick.mom",
	"appName": "2Click MoM",
	"webDir": "dist/client",
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#FFFFFF"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#0B4BD5",
			"showSpinner": false,
			"showDuration": 400
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0B4BD5"
		},
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		}
	},
	"server": {
		"androidScheme": "https"
	}
}
