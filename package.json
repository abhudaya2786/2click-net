{
  "name": "2click-voice-mom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "2Click.in — Voice Minutes of Meeting AI",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:vercel-api": "mkdir -p api && esbuild scripts/vercel-api-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build:vercel": "node scripts/build-vercel-output.mjs",
    "build": "npm run build:client && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run lint && node scripts/smoke-test.mjs && node scripts/test-voice-match.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:voice": "node scripts/test-voice-match.mjs",
    "test:enterprise": "node scripts/enterprise-smoke.mjs",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "cap:sync": "npm run build:client && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk": "bash scripts/build-apk.sh",
    "pack:hostinger": "bash scripts/pack-hostinger.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fontkit": "^2.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.4.0",
    "pdfkit": "^0.19.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "restructure": "^3.0.2",
    "vite": "^6.2.3",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": "22.x"
  }
}
