# Required for live transcription + MoM generation.
# If unset, the app runs in demo mode: transcript→MoM heuristics work; audio STT needs a key.
GEMINI_API_KEY=

# Optional — prefer OpenAI when set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=gemini
GEMINI_FIELD_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Client (build-time) — native APK API host override
# VITE_API_BASE_URL=https://2click.in

# Server
PORT=3000
HOST=0.0.0.0

# Public base URL (used to attach PDF links on WhatsApp document messages)
PUBLIC_BASE_URL=http://localhost:3000

# Privacy / Zero-Liability
ZERO_AUDIO_RETENTION=true
PII_REDACTION_ENABLED=true
DISCARD_SMALL_TALK=true

# Field audio chunking
AUDIO_CHUNK_SECONDS=30
AUDIO_OVERLAP_SECONDS=2
FIELD_GEOFENCE_RADIUS_M=50
PDF_STORAGE_DIR=data/field-pdfs
FIELD_STORE_DIR=data/field-visits

# Meta WhatsApp Business Cloud API
# Leave ACCESS_TOKEN empty to run in safe mock mode (logs only).
# Rotate VERIFY_TOKEN in production — do not use the sample value.
WHATSAPP_VERIFY_TOKEN=change-me-2click-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OWNER_PHONE=

# Billing (simulated until live SDK + secrets)
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
