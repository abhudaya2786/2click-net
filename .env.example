# Required for live transcription + MoM generation.
# If unset, field/domain MoM and STT endpoints return 503; privacy/PDF/WhatsApp mock still work.
GEMINI_API_KEY=

# Optional — prefer OpenAI when set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_PROVIDER=gemini
GEMINI_FIELD_MODEL=gemini-2.5-flash

# Server
PORT=3000
HOST=0.0.0.0

# Public base URL (used to attach PDF links on WhatsApp document messages)
PUBLIC_BASE_URL=http://localhost:3000

# Privacy / Zero-Liability
ZERO_AUDIO_RETENTION=true
PII_REDACTION_ENABLED=true
DISCARD_SMALL_TALK=true

# Field audio chunking
AUDIO_CHUNK_SECONDS=30
AUDIO_OVERLAP_SECONDS=2
FIELD_GEOFENCE_RADIUS_M=50
PDF_STORAGE_DIR=data/field-pdfs
FIELD_STORE_DIR=data/field-visits

# Meta WhatsApp Business Cloud API
# Leave ACCESS_TOKEN empty to run in safe mock mode (logs only).
WHATSAPP_VERIFY_TOKEN=2click-mom-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_OWNER_PHONE=

# Optional billing (existing)
# BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
