# Copy to .env and fill values (never commit real secrets)
# cp .env.example .env

# Optional — when set, uses Gemini for higher-quality normalization.
# Without a key, the service uses the built-in Hinglish heuristic engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional OpenAI fallback (used if GEMINI_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server
HOST=0.0.0.0
PORT=8088
