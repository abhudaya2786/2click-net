# Copy to .env and replace the placeholder with your real key:
# cp .env.example .env

GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

HOST=0.0.0.0
PORT=8000

# PostgreSQL (optional — Instant Save / users / tasks)
# psql "$DATABASE_URL" -f schema.sql
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hinglish_normalizer
